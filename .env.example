PORT=3001
# Used by the development browser origin check; production uses PORT.
WEB_PORT=5173
# Optional progress path. Browser tests use an in-memory database.
SQLITE_PATH=data/app.sqlite
# Optional local AI feedback. Reviews and authored lessons work without a model.
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_URL=http://127.0.0.1:11434
# Per HTTP request, including model loading; malformed output is retried once.
OLLAMA_TIMEOUT_MS=120000
